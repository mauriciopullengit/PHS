{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--console-level",
        "warning"
      ]
    },
    "powershell": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "mcp-powershell-exec"
      ]
    }
  }
}
